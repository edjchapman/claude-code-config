# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
# uv generates uv.lock even though pyproject.toml has no [project] table
# (it only configures ruff). Nothing meaningful to lock.
uv.lock

# Root settings file (for local development/testing only)
/settings.local.json

# Claude Code local config (symlinks are machine-specific)
.claude/*
!.claude/settings.local.json
# ...but hand-authored skills here ARE source, not machine-specific symlinks.
!.claude/skills/

# Session-end log hook output (local artifact, written by hooks)
/standups/

# Artifacts of an external agent-sync tool (Codex/AGENTS.md mirroring).
# Machine-local and regenerated, not source — AGENTS.md here is a copy of
# CLAUDE.md, so tracking it would duplicate the file and invite drift.
/AGENTS.md
/.agents/
/skills/synced/
